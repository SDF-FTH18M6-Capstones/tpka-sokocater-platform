erDiagram
    USERS {
        int id PK
        string full_name
        string email UK
        string password_hash
        string role
        string phone_number
        datetime created_at
    }

    CATERER_PROFILES {
        int id PK
        int user_id FK, UK
        string business_name
        text description
        string location
        string contact_number
        string business_image
        string verification_status
        datetime created_at
    }

    CUISINES {
        int id PK
        string cuisine_name UK
    }

    CATERER_CUISINES {
        int id PK
        int caterer_id FK
        int cuisine_id FK
    }

    MENUS {
        int id PK
        int caterer_id FK
        string menu_name
        text description
        datetime created_at
    }

    MENU_ITEMS {
        int id PK
        int menu_id FK
        string item_name
        text description
        decimal price
        string image_url
    }

    PACKAGES {
        int id PK
        int caterer_id FK
        string package_name
        text description
        decimal price_per_guest
        int minimum_guests
        int maximum_guests
    }

    PACKAGE_ITEMS {
        int id PK
        int package_id FK
        int menu_item_id FK
    }

    ADD_ONS {
        int id PK
        int caterer_id FK
        string addon_name
        text description
        decimal price
    }

    BOOKINGS {
        int id PK
        int customer_id FK
        int caterer_id FK
        date event_date
        time event_start_time
        time event_end_time
        string event_type
        string event_location
        int guest_count
        decimal estimated_total
        string status
        datetime created_at
    }

    BOOKING_ITEMS {
        int id PK
        int booking_id FK
        int package_id FK
        int addon_id FK
        int quantity
        decimal unit_price
    }

    AVAILABILITY {
        int id PK
        int caterer_id FK
        date available_date
        time start_time
        time end_time
        string status
    }

    PAYMENTS {
        int id PK
        int booking_id FK
        decimal amount
        string payment_method
        string transaction_reference UK
        string payment_status
        datetime paid_at
    }

    REVIEWS {
        int id PK
        int customer_id FK
        int caterer_id FK
        int booking_id FK, UK
        int rating
        text comment
        datetime created_at
    }

    NOTIFICATIONS {
        int id PK
        int user_id FK
        text message
        string notification_type
        boolean is_read
        datetime created_at
    }

    USERS ||--o| CATERER_PROFILES : owns
    USERS ||--o{ BOOKINGS : makes
    USERS ||--o{ REVIEWS : writes
    USERS ||--o{ NOTIFICATIONS : receives

    CATERER_PROFILES ||--o{ MENUS : offers
    CATERER_PROFILES ||--o{ PACKAGES : creates
    CATERER_PROFILES ||--o{ ADD_ONS : provides
    CATERER_PROFILES ||--o{ BOOKINGS : receives
    CATERER_PROFILES ||--o{ AVAILABILITY : manages
    CATERER_PROFILES ||--o{ REVIEWS : receives

    CUISINES ||--o{ CATERER_CUISINES : categorizes
    CATERER_PROFILES ||--o{ CATERER_CUISINES : offers

    MENUS ||--o{ MENU_ITEMS : contains

    PACKAGES ||--o{ PACKAGE_ITEMS : includes
    MENU_ITEMS ||--o{ PACKAGE_ITEMS : belongs_to

    BOOKINGS ||--o{ BOOKING_ITEMS : contains
    PACKAGES ||--o{ BOOKING_ITEMS : selected_in
    ADD_ONS ||--o{ BOOKING_ITEMS : selected_in

    BOOKINGS ||--o{ PAYMENTS : has
    BOOKINGS ||--o| REVIEWS : receives